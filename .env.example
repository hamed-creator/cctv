PORT=8080

# Single-camera fallback. For multiple cameras, use RTSP_URL_1, RTSP_URL_2, ...
RTSP_URL=rtsp://admin:PASSWORD@CAMERA_HOST:554/H264?ch=1&subtype=0

# Optional per-camera configuration when using RTSP_URL_1, RTSP_URL_2, ...
# CAMERA_NAME_1=Front gate

# Optional lifecycle tuning
IDLE_SHUTDOWN_MS=15000
DATA_WATCHDOG_MS=10000

# RTSP buffering. Increase RTSP_BUFFER_SIZE if packet bursts still underrun.
RTSP_ANALYZE_DURATION=1000000
RTSP_PROBE_SIZE=1000000
RTSP_BUFFER_SIZE=32M

# Optional path to a system FFmpeg executable; otherwise ffmpeg-static is used.
# FFMPEG_PATH=C:\\path\\to\\ffmpeg.exe